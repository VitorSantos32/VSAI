<Window x:Class="VSAI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VS AI - Login"
        Width="480"
        Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="ThemeColor" Color="#FF2ECC71"/>
        <SolidColorBrush x:Key="ThemeColorHover" Color="#FF27AE60"/>
        <SolidColorBrush x:Key="ThemeColorLight" Color="#FF58D68D"/>
        
        <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF151515"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                CornerRadius="8" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                <TextBlock x:Name="placeholder" 
                                           Text="Insira sua licença aqui..." 
                                           Foreground="#88FFFFFF" 
                                           FontSize="13" 
                                           Padding="10,8" 
                                           IsHitTestVisible="False" 
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ThemeColor}"/>
                                <Setter TargetName="border" Property="Background" Value="#FF1C1C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Outer Border with shadow glow -->
        <Border x:Name="MainBorder" CornerRadius="16" BorderThickness="1" Background="#FF0C0C0C">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF2ECC71" Offset="0"/>
                    <GradientStop Color="#222ECC71" Offset="0.5"/>
                    <GradientStop Color="#FF2ECC71" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#FF2ECC71" BlurRadius="15" Opacity="0.15" ShadowDepth="0"/>
            </Border.Effect>

            <Grid>
                <!-- Close Button -->
                <Button x:Name="BtnClose" 
                        Content="✕" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Margin="0,15,15,0" 
                        Background="Transparent" 
                        Foreground="#88FFFFFF" 
                        BorderThickness="0" 
                        Width="24" 
                        Height="24"
                        Cursor="Hand"
                        Click="BtnClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Main Content Panel -->
                <StackPanel Margin="30,40,30,20" VerticalAlignment="Center">
                    <!-- Title -->
                    <TextBlock Text="VS AI GLOBAL" 
                               Foreground="White" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               FontFamily="Atkinson Hyperlegible"/>
                    
                    <!-- Subtitle -->
                    <TextBlock Text="VALIDAÇÃO DE LICENÇA" 
                               Foreground="{StaticResource ThemeColor}" 
                               FontSize="10" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center" 
                               Margin="0,2,0,25"/>

                    <!-- Input Label -->
                    <TextBlock Text="CHAVE DE LICENÇA" 
                               Foreground="#88FFFFFF" 
                               FontSize="10" 
                               Margin="2,0,0,5" 
                               FontWeight="Bold"/>

                    <!-- License Input -->
                    <TextBox x:Name="TxtLicenseKey" 
                             Style="{StaticResource PlaceholderTextBoxStyle}"
                             Margin="0,0,0,15"
                             FontFamily="Consolas"
                             KeyDown="TxtLicenseKey_KeyDown"/>

                    <!-- Action Button -->
                    <Button x:Name="BtnValidate" 
                            Content="VALIDAR ACESSO" 
                            Height="38" 
                            Background="{StaticResource ThemeColor}" 
                            Foreground="Black" 
                            FontWeight="Bold" 
                            FontSize="12"
                            Cursor="Hand"
                            Click="BtnValidate_Click"
                            Margin="0,5,0,15">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ThemeColorHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Loading / Progress Dots -->
                    <Grid x:Name="LoadingSpinner" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Conectando e verificando licença..." Foreground="#88FFFFFF" FontSize="11"/>
                    </Grid>

                    <!-- Error / Status Message -->
                    <TextBlock x:Name="LblStatus" 
                               Text="" 
                               Foreground="Red" 
                               FontSize="11" 
                               HorizontalAlignment="Center" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               Margin="0,0,0,10"
                               Height="32"/>

                    <!-- HWID Footer -->
                    <Border Background="#FF101010" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SEU HWID: " Foreground="#55FFFFFF" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtHwid" Text="-" Foreground="#88FFFFFF" FontSize="9" FontFamily="Consolas" VerticalAlignment="Center" Margin="5,0,10,0"/>
                            <Button Content="COPIAR" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Foreground="{StaticResource ThemeColor}" 
                                    FontSize="9" 
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="BtnCopyHwid_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
