<UserControl x:Class="VSAI.Controls.AboutMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Ant="clr-namespace:AntWpf.Controls;assembly=AntWpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <ScrollViewer x:Name="AboutMenu"
                  VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="20">

            <!-- Hero Section -->
            <Border Background="#15FFFFFF"
                    BorderBrush="#3FFFFFFF"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="24"
                    Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">

                    <!-- Logo -->
                    <Image x:Name="AboutVSAILogo"
                           Source="/Graphics/logovs.png"
                           HorizontalAlignment="Center"
                           Width="80"
                           Height="80"
                           Margin="0,0,0,12" />

                    <!-- Title & Version -->
                    <TextBlock Text="VS AI"
                               FontFamily="{StaticResource Atkinson Hyperlegible}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Seu Segundo Olho Universal"
                               FontFamily="{StaticResource Atkinson Hyperlegible}"
                               FontSize="12"
                               Foreground="#99FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,8"/>
                    <Border x:Name="VersionBorder"
                            Background="{DynamicResource ThemeColor}"
                            CornerRadius="5"
                            Padding="12,4"
                            HorizontalAlignment="Center">
                        <Label x:Name="AboutDesc"
                               Content="v2.5.0"
                               FontFamily="{StaticResource Atkinson Hyperlegible}"
                               FontSize="11"
                               Foreground="White"
                               Padding="0"/>
                    </Border>

                    <!-- System Specs -->
                    <Label x:Name="AboutSpecs"
                           Content="Intel I5-13400F | NVIDIA GTX 1050"
                           FontFamily="{StaticResource Atkinson Hyperlegible}"
                           Foreground="#60FFFFFF"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           Padding="0"/>
                </StackPanel>
            </Border>

            <!-- Core Team Section -->
            <Border Background="#10FFFFFF"
                    BorderBrush="#3FFFFFFF"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="20"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="CORE TEAM"
                               FontFamily="{StaticResource Atkinson Hyperlegible}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#60FFFFFF"
                               Margin="0,0,0,16"
                               HorizontalAlignment="Center"/>

                    <!-- Developers Container - populated from code -->
                    <UniformGrid x:Name="CoreTeamPanel"
                                 Columns="3"
                                 HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Community Section -->
            <Border Background="#08FFFFFF"
                    BorderBrush="#3FFFFFFF"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="BY VS"
                               FontFamily="{StaticResource Atkinson Hyperlegible}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#70FFFFFF"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Discord Link -->
            <Ant:Button x:Name="DiscordButton"
                        Background="#5865F2"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        FontWeight="Normal"
                        FontSize="11"
                        Height="36"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        FontFamily="{StaticResource Atkinson Hyperlegible}"
                        EffectBrush="#7289DA"
                        Click="DiscordButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8BD;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Entrar no Discord"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Ant:Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
