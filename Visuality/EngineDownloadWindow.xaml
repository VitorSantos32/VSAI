<Window x:Class="Visuality.EngineDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:theme="clr-namespace:VSAI.Theme"
        theme:ThemeBehavior.AutoRegister="True"
        Title="Download do Motor"
        Height="150"
        Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Grid Margin="10">
        <Border x:Name="MainBorder"
                CornerRadius="8"
                BorderBrush="{DynamicResource ThemeColorDark}"
                BorderThickness="1"
                Padding="0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0,0">
                    <GradientStop Color="Black" Offset="0.27" />
                    <GradientStop Color="#FF120338" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Title Bar -->
                <DockPanel Grid.Row="0" Background="{DynamicResource ThemeColor}" MouseDown="Header_MouseDown">
                    <Border Padding="8" Background="Transparent" DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Graphics/logovs.png"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,8,0" />
                            <TextBlock Text="VS - Download de Componente"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DockPanel>
                
                <!-- Content Area -->
                <Grid Grid.Row="1" Margin="15,10,15,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock x:Name="EngineLabel" 
                               Text="Motor: N/A" 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Grid.Row="0" 
                               Margin="0,0,0,5"/>
                    
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <ProgressBar x:Name="ProgressBarControl" 
                                     Minimum="0" 
                                     Maximum="100" 
                                     Height="8" 
                                     Foreground="{DynamicResource ThemeColor}" 
                                     Background="#33FFFFFF" 
                                     BorderThickness="0" 
                                     Value="0"
                                     materialDesign:TransitionAssist.DisableTransitions="True"/>
                        
                        <TextBlock x:Name="StatusTextControl" 
                                   Text="Iniciando download..." 
                                   Foreground="#FFAAAAAA" 
                                   FontSize="11" 
                                   FontFamily="Segoe UI"
                                   Margin="0,5,0,0" 
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
